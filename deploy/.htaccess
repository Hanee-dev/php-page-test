# 서버 www/(웹 루트)에 deploy/ 전체가 올라가므로 public/ 만 외부에 노출되도록 내부 rewrite
Options -Indexes

# .ftp-deploy-sync-state.json 등 숨김 파일 차단
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
